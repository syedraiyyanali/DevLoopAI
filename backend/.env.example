DEVLOOPAI_APP_NAME=DevLoopAI API
DEVLOOPAI_APP_VERSION=0.1.0
DEVLOOPAI_ENVIRONMENT=development
DEVLOOPAI_DEBUG=true
DEVLOOPAI_LOG_LEVEL=INFO
DEVLOOPAI_DATABASE_PATH=data/devloopai.sqlite3

DEVLOOPAI_API_PREFIX=/api/v1

DEVLOOPAI_OLLAMA_BASE_URL=http://localhost:11434
DEVLOOPAI_OLLAMA_MODEL=qwen2.5-coder:7b

DEVLOOPAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
